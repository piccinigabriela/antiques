rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura de piezas de anticuarios, galerías y ofertas para el catálogo en vivo
    match /antique_items/{itemId} {
      allow read, write: if true;
    }
    match /dealers/{dealerId} {
      allow read, write: if true;
    }
    match /negotiation_offers/{offerId} {
      allow read, write: if true;
    }
    match /system_meta/{metaId} {
      allow read, write: if true;
    }
    match /test/{id} {
      allow read, write: if true;
    }
  }
}
